// Generated (by a script reading each source's own SFZ mappings, or its file
// names where it ships none, then downloading every file to pin it and
// measuring roots and levels); the comments say where each set's zones
// came from. The sources and their licences are in register.odin.
package odawg_assets

SET_TABLE := [?]Set_Row {
	{"vcsl/upright_piano", .VCSL, "Yamaha upright piano: C and G of every octave, three velocity layers", -5.8, 15.3, {0, 38}},
	{"vcsl/fm_piano", .VCSL, "Yamaha TX81Z FM electric piano: major thirds, three velocity layers", 7.3, 12.3, {38, 66}},
	{"osiris/soft_piano", .Osiris, "Yamaha C2 grand, half-stick and soft pedal: a quiet, intimate piano; two velocity layers", -5.6, 15.4, {104, 105}},
	{"karoryfer/growlybass", .Growlybass, "Squier Jazz Bass, fingered, recorded direct: three velocity layers, two round robins", -6, 18.8, {209, 84}},
	{"vsco2/strings", .VSCO2, "string ensemble sustains with vibrato: cello, viola and violin sections; two velocity layers", -2.9, 19.9, {293, 36}},
	{"virtuosity/drums", .Virtuosity, "jazz drum kit through a stereo kit mic: kick, snare, cross-stick, hats, two toms, crash, ride; velocity layers and round robins", -6.5, 11.5, {329, 313}},
}

